# This script is boot.scr on the FAT boot partition. The image size and CRC
# are filled in from imx-boot deployed with this image.

setenv cl_update_addr 0x83000000
setenv cl_verify_addr 0x88000000
setenv cl_update_found no
setenv cl_update_board no
setenv cl_update_marker @IMAGE_CRC32@.OK
setenv cl_update_devpart
setenv cl_update_verified no
setenv cl_update_reset no

@BOARD_GUARD@

# Match the boot container on the boot media based on its size/CRC
setenv check_image 'if itest ${filesize} == @IMAGE_SIZE@; then if crc32 -v ${cl_update_addr} @IMAGE_SIZE@ @IMAGE_CRC32@; then setenv cl_update_found yes; fi; fi'
if test "${cl_update_board}" = yes && usb start; then
    setenv cl_update_iface usb
    setenv cl_update_devpart 0:1
    if load usb 0:1 ${cl_update_addr} imx-boot; then
        run check_image
    fi
fi
if test "${cl_update_board}" = yes && test "${cl_update_found}" != yes; then
    setenv cl_update_iface mmc
    setenv cl_update_devpart 1:1
    if mmc dev 1 0; then
        if load mmc 1:1 ${cl_update_addr} imx-boot; then
            run check_image
        fi
    fi
fi
if test "${cl_update_board}" = yes && test "${cl_update_found}" != yes; then
    setenv cl_update_iface mmc
    setenv cl_update_devpart 0:1
    if mmc dev 0 0; then
        if load mmc 0:1 ${cl_update_addr} imx-boot; then
            run check_image
        fi
    fi
fi

if test "${cl_update_found}" = yes; then
    # The marker belongs to the same FAT partition as the matching imx-boot.
    # Its name identifies this release; its contents catch interrupted writes.
    setenv cl_update_done no
    if load ${cl_update_iface} ${cl_update_devpart} ${cl_verify_addr} ${cl_update_marker}; then
        if itest ${filesize} == 0x4; then
            if crc32 -v ${cl_verify_addr} 0x4 @MARKER_CRC32@; then
                setenv cl_update_done yes
            fi
        fi
    fi
    if test "${cl_update_done}" = yes; then
        echo CompuLab bootloader is updated for this release
    else if mmc dev 0 1; then
        if mmc read ${cl_verify_addr} 0 @IMAGE_BLOCKS@; then
            if cmp.b ${cl_update_addr} ${cl_verify_addr} @IMAGE_SIZE@; then
                echo CompuLab bootloader is already current
                if mmc partconf 0 cl_enabled_bootpart; then
                    if test "${cl_enabled_bootpart}" = 1; then
                        setenv cl_update_verified yes
                    else
                        if mmc partconf 0 0 1 0; then
                            setenv cl_update_verified yes
                            setenv cl_update_reset yes
                        else
                            echo WARN: Could not enable eMMC boot0
                        fi
                    fi
                else
                    echo WARN: Could not read eMMC boot configuration
                fi
            else
                echo Updating CompuLab bootloader in eMMC boot0
                if mmc write ${cl_update_addr} 0 @IMAGE_BLOCKS@; then
                    if mmc read ${cl_verify_addr} 0 @IMAGE_BLOCKS@; then
                        if cmp.b ${cl_update_addr} ${cl_verify_addr} @IMAGE_SIZE@; then
                            if mmc partconf 0 0 1 0; then
                                setenv cl_update_verified yes
                                setenv cl_update_reset yes
                            fi
                        fi
                    fi
                fi
                if test "${cl_update_verified}" != yes; then
                    echo ERROR: eMMC bootloader update failed; recover through SDP
                    poweroff
                    exit
                fi
            fi
        else
            echo WARN: Could not read eMMC boot0; bootloader update skipped
        fi
    else
        echo WARN: eMMC boot0 is unavailable; bootloader update skipped
    fi; fi
    if test "${cl_update_verified}" = yes; then
        # eMMC FAT lives in the user area, not boot0. Switch back before
        # writing the marker, including when the source is USB or SD.
        mmc dev 0 0
        mw.l ${cl_verify_addr} 0x@IMAGE_CRC32@ 1
        if fatwrite ${cl_update_iface} ${cl_update_devpart} ${cl_verify_addr} ${cl_update_marker} 0x4; then
            if load ${cl_update_iface} ${cl_update_devpart} ${cl_verify_addr} ${cl_update_marker}; then
                if itest ${filesize} == 0x4 && crc32 -v ${cl_verify_addr} 0x4 @MARKER_CRC32@; then
                    echo Bootloader update marker verified
                else
                    echo WARN: Bootloader update marker verification failed; later downgrade remains possible
                fi
            else
                echo WARN: Bootloader update marker could not be read; later downgrade remains possible
            fi
        else
            echo WARN: Bootloader update marker could not be written; later downgrade remains possible
        fi
        if test "${cl_update_reset}" = yes; then
            echo Bootloader update verified
            reset
        fi
    fi
else
    echo WARN: Bootloader update skipped: unknown board or image unavailable
fi

# The normal boot flow (or Linux after USB/SD boot) must see the eMMC user area.
mmc dev 0 0

# The current U-Boot boot flow loads boot.scr on every medium. Disable the
# script for this boot only, then resume normal USB, SD, eMMC boot priority.
setenv script .cl-boot-update-complete
run bsp_bootcmd
