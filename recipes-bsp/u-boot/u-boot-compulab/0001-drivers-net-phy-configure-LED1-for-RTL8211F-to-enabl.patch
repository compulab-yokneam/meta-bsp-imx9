From ec4d0e07c62e458e6b93baa9f06183f06eec6beb Mon Sep 17 00:00:00 2001
From: yaakov entin <yaakov.entin@compulab.co.il>
Date: Mon, 4 May 2026 15:44:00 +0300
Subject: [PATCH] drivers- net- phy: configure LED1 for RTL8211F to enable
 yellow LED on ucm-imx93

---
 drivers/net/phy/realtek.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/net/phy/realtek.c b/drivers/net/phy/realtek.c
index 7e1036b2271..834169faffd 100644
--- a/drivers/net/phy/realtek.c
+++ b/drivers/net/phy/realtek.c
@@ -261,7 +261,8 @@ static int rtl8211f_config(struct phy_device *phydev)
 	/* Set green LED for Link, yellow LED for Active */
 	phy_write(phydev, MDIO_DEVAD_NONE,
 		  MIIM_RTL8211F_PAGE_SELECT, 0xd04);
-	phy_write(phydev, MDIO_DEVAD_NONE, 0x10, 0x617f);
+	reg = (0b1011 << 10 | 0b1011 << 5 | 0b11011); // led1,2 (offset 5,10) - link all speeds, led0 (offset 0) - link all speeds and active (active only mode NA)
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x10, reg);
 	phy_write(phydev, MDIO_DEVAD_NONE,
 		  MIIM_RTL8211F_PAGE_SELECT, 0x0);
 
